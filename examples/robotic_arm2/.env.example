# Copy this file to .env and fill in real values for your rig.
# Nothing here has a silent default -- main.py raises KeyError immediately if
# a required variable is missing.

# The manipulation goal handed to the agent.
ROBOTIC_ARM_QUERY="Pick up the tape roll and place it on the book."

# Main, vision-capable planning LLM -- the only model involved (no separate
# constraint-generation VLM, unlike examples/robotic_arm/.env.example).
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o
API_KEY=your-api-key-here
API_BASE=https://api.openai.com/v1

# Robot workspace bounds (metres, robot base frame): comma-separated x,y,z.
ARM_WORKSPACE_MIN=0.0,-0.25,0.0
ARM_WORKSPACE_MAX=0.35,0.25,0.30

# Camera calibration (.npy files) -- see vendors/so101/backend.py.
CAMERA_MATRIX_PATH=/path/to/camera_matrix.npy
DEPTH_SCALE_PATH=/path/to/depth_scale.npy
EXTRINSICS_PATH=/path/to/T_base_camera.npy

# SO-101 kinematics + hardware.
URDF_PATH=/path/to/so101.urdf
ROBOT_PORT=/dev/ttyACM0

# MobileSAM checkpoint (vit_t) -- see vendors/so101/perception.py.
SAM_CHECKPOINT_PATH=/path/to/mobile_sam.pt

# Optional runtime tuning (see RoboticArm2RuntimeSettings) -- all have defaults.
# ARM2_PHOTO_MAX_WIDTH=1280
# ARM2_PHOTO_JPEG_QUALITY=85
# ARM2_MCS_SCREENSHOTS_TO_KEEP=3
# ARM2_CONTEXT_MAX_MESSAGES=120
# ARM2_CONTEXT_WINDOW_ROUNDS=20
